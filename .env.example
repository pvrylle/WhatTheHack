# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# Site Configuration (Optional)
# ===========================================
# Set this to your custom domain if you have one
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===========================================
# API Configuration
# ===========================================
# Leave empty to use internal Next.js API routes
NEXT_PUBLIC_API_URL=

# Set to 'true' to use mock data instead of Supabase
NEXT_PUBLIC_USE_MOCK=false

# ===========================================
# Vercel Auto-Generated (Do not set manually)
# ===========================================
# VERCEL_URL - Automatically set by Vercel
# NEXT_PUBLIC_VERCEL_URL - Available on client if needed
